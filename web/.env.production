# Public Sanity config, inlined at build time (NEXT_PUBLIC_*). These are not
# secrets — the project id is exposed in the client bundle by design. The only
# value that must stay secret would be a Sanity write token, which this site
# does not use (read-only published content over the public API/CDN).
NEXT_PUBLIC_SANITY_PROJECT_ID=7plawvk9
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-01
