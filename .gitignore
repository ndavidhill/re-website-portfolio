# OS
.DS_Store

# Local agent / editor config
.claude/

# Local working assets (source files, not needed for the build)
/Case Studies/

# Dependencies & build artifacts (also covered by per-package .gitignores)
node_modules/
.next/
/web/out/
dist/
build/

# Env — local/secret env stays out; committed public .env.production ships
.env*.local

# Vercel
.vercel

# Prismic migration snapshot — regenerable via studio/migration/pull.mjs
studio/migration/raw/
# Generated triage artifacts — regenerable via build-index.mjs (selection.json is kept)
studio/migration/triage.csv
studio/migration/triage.html
# Generated transform output — regenerable via transform.mjs, but the NDJSON is
# committed so the import can be run from another machine after a plain git pull.
studio/migration/out/*
!studio/migration/out/*.ndjson
